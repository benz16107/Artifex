
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# Optional: LLM HTTP timeouts (seconds). Spec parsing defaults to 20s; reference PDF/image analysis defaults to 180s.
# SPEC_LLM_TIMEOUT_SECONDS=20
# ASSET_ANALYSIS_LLM_TIMEOUT_SECONDS=180
# ASSET_ANALYSIS_LLM_MAX_RETRIES=1

# Brand research uses Tavily for live web search before concept reference images.
# Without TAVILY_API_KEY, research still runs but only uses your idea + uploaded documents (no web).
# https://tavily.com — create a key and set:
# TAVILY_API_KEY=tvly-...
# RESEARCH_LLM_TIMEOUT_SECONDS=120
# RESEARCH_LLM_MAX_RETRIES=1
# RESEARCH_TAVILY_MAX_RESULTS=5
# RESEARCH_MAX_QUERIES=3

# Pipeline: reference images (OpenAI) + Meshy image-to-3D after POST /jobs/{id}/confirm-concept
# Reference images use OpenAI only: POST .../v1/images/generations (see https://platform.openai.com )
# DeepSeek (and other) keys are invalid there — HTTP 401 if you reuse them.
#
# All-OpenAI: OPENAI_API_KEY=sk-... plus optional OPENAI_BASE_URL=https://api.openai.com (default if unset).
# Same key is reused for concept reference images unless OPENAI_BASE_URL is a blocked third-party host.
# Split stack (DeepSeek chat + concept images): set all of these:
# IMAGE_OPENAI_API_KEY=sk-...   # must be from OpenAI, not DeepSeek
# IMAGE_OPENAI_BASE_URL=https://api.openai.com
# IMAGE_OPENAI_MODEL=gpt-image-1
# Optional: model used when the UI enables “Faster reference images” (defaults to gpt-image-1-mini if unset):
# IMAGE_OPENAI_MODEL_FAST=gpt-image-1-mini
# Optional: if IMAGE_OPENAI_MODEL is dall-e-3, set a GPT image model for three-quarter (from front PNG via /images/edits):
# IMAGE_OPENAI_EDIT_MODEL=gpt-image-1-mini
# MESHY_API_KEY=...   # image->mesh; optional if you add another backend later
# Optional: Meshy HTTP (poll can hit transient timeouts; defaults are usually enough)
# MESHY_HTTP_TIMEOUT_SECONDS=120
# MESHY_HTTP_RETRIES=4

# Optional: queue mode
# QUEUE_BACKEND=inline   # inline | rq
# REDIS_URL=redis://localhost:6379/0

# Optional: artifact storage (meshes, STEP, spec.json). PNG previews use the same URLs unless Cloudinary is on.
# STORAGE_BACKEND=local   # local | s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=

# Optional: Cloudinary CDN for preview.png and concept reference PNGs (secure_url in job JSON).
# GLB/STEP/STL/spec still follow STORAGE_BACKEND. Set all three to enable uploads + GET /ready checks Cloudinary ping.
# CLOUDINARY_CLOUD_NAME must equal the dashboard "Cloud name" (not a placeholder — values like "Soon" fail at upload).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Optional: Composio (pull context from connected apps into “Context documents”)
# COMPOSIO_API_KEY=
# Comma-separated toolkit slugs (aliases: google_drive, drive → googledrive)
# COMPOSIO_ALLOWED_TOOLKITS=googledrive,notion
# COMPOSIO_FETCH_TIMEOUT_SECONDS=45
# Optional: pin tool schema version for execute (do not set to the word "latest"). If unset, the API uses
# dangerously_skip_version_check=True. Example: COMPOSIO_TOOL_EXECUTE_VERSION=20250509_01
# After OAuth, redirect users here (optional)
# COMPOSIO_OAUTH_CALLBACK_URL=http://localhost:3000/
# If set, POST /composio/connect may include callback_url only when it starts with one of these prefixes
# COMPOSIO_OAUTH_CALLBACK_URL_PREFIXES=http://localhost:3000/,https://app.example.com/
#
# If Drive pull returns HTTP 403, share the file with the same Google account you used in Composio, or
# disconnect/reconnect Google Drive in Composio so OAuth includes download tools.
#
# If POST /composio/connect returns HTTP 502, Composio’s API returned an error (often transient): retry,
# confirm the API key, and check allowed callback URLs in the Composio project. HTTP 409 means the toolkit
# is already connected for this user_id — use Pull into context instead of Connect.

# Optional: Backboard (https://docs.backboard.io/) for research synthesis, web search, thread RAG, memory, asset analysis.
# Master switch (default off): set to 1 before any ARTIFEX_BACKBOARD_* feature runs (avoids stray shell-only env).
# ARTIFEX_USE_BACKBOARD=1
# BACKBOARD_API_KEY=
# BACKBOARD_BASE_URL=https://app.backboard.io/api
# Optional: pin all jobs to one assistant (shared memory + assistant-level documents in Backboard).
# BACKBOARD_ASSISTANT_ID=
# BACKBOARD_LLM_PROVIDER=openai
# BACKBOARD_MODEL_NAME=gpt-4o
# BACKBOARD_HTTP_TIMEOUT_SECONDS=180
# BACKBOARD_DOCUMENT_POLL_INTERVAL_SECONDS=2
# BACKBOARD_DOCUMENT_POLL_MAX_SECONDS=180
# Memory Lite on sends: off | Auto | Readonly
# BACKBOARD_MEMORY=off
#
# Use Backboard for brand-research JSON synthesis instead of OpenAI chat completions (requires BACKBOARD_API_KEY).
# ARTIFEX_BACKBOARD_RESEARCH_SYNTHESIS=0
# Skip Tavily and use Backboard web_search Auto on that synthesis call (requires ARTIFEX_BACKBOARD_RESEARCH_SYNTHESIS).
# ARTIFEX_BACKBOARD_RESEARCH_SKIP_TAVILY=0
# Keep Tavily snippets in the prompt and also enable Backboard web_search (JSON may be returned as prose; parsing is best-effort).
# ARTIFEX_BACKBOARD_RESEARCH_MERGE_WEB=0
# Upload internal context strings as Backboard thread documents (RAG) before synthesis (requires BACKBOARD_API_KEY and ARTIFEX_BACKBOARD_RESEARCH_SYNTHESIS).
# ARTIFEX_BACKBOARD_RESEARCH_THREAD_DOCS=0
# Analyze uploaded reference files via Backboard multipart /threads/messages instead of OpenAI chat completions.
# ARTIFEX_BACKBOARD_ASSET_ANALYSIS=0

# Optional: Pingram (https://www.pingram.io/) — “Contact a supplier” email from the manufacturing tab.
# Create an API key under Environments in the Pingram dashboard, then restart the Django API.
# PINGRAM_API_KEY=pingram_sk_...
# Optional: EU / Canada hosts — defaults to US https://api.pingram.io
# PINGRAM_BASE_URL=https://api.eu.pingram.io
# Notification type id created on first send if missing (inline email + forceChannels EMAIL on the server).
# PINGRAM_NOTIFICATION_TYPE=artifex_supplier_inquiry

