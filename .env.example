
SPEC_PARSER_MODE=auto
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# Pipeline: reference images (OpenAI) + Meshy image-to-3D after POST /jobs/{id}/confirm-concept
# Reference images use OpenAI only: POST .../v1/images/generations (see https://platform.openai.com )
# DeepSeek (and other) keys are invalid there — HTTP 401 if you reuse them.
#
# All-OpenAI: OPENAI_API_KEY=sk-... plus optional OPENAI_BASE_URL=https://api.openai.com (default if unset).
# Same key is reused for concept reference images unless OPENAI_BASE_URL is a blocked third-party host.
# Split stack (DeepSeek chat + concept images): set all of these:
# IMAGE_OPENAI_API_KEY=sk-...   # must be from OpenAI, not DeepSeek
# IMAGE_OPENAI_BASE_URL=https://api.openai.com
# IMAGE_OPENAI_MODEL=gpt-image-1
# Optional: if IMAGE_OPENAI_MODEL is dall-e-3, set a GPT image model for three-quarter (from front PNG via /images/edits):
# IMAGE_OPENAI_EDIT_MODEL=gpt-image-1-mini
# MESHY_API_KEY=...   # image->mesh; optional if you add another backend later

# Optional: queue mode
# QUEUE_BACKEND=inline   # inline | rq
# REDIS_URL=redis://localhost:6379/0

# Optional: Composio (pull context from connected apps into “Context documents”)
# COMPOSIO_API_KEY=
# Comma-separated toolkit slugs (aliases: google_drive, drive → googledrive)
# COMPOSIO_ALLOWED_TOOLKITS=googledrive,notion
# COMPOSIO_FETCH_TIMEOUT_SECONDS=45
# Optional: pin tool schema version for execute (do not set to the word "latest"). If unset, the API uses
# dangerously_skip_version_check=True. Example: COMPOSIO_TOOL_EXECUTE_VERSION=20250509_01
# After OAuth, redirect users here (optional)
# COMPOSIO_OAUTH_CALLBACK_URL=http://localhost:3000/
# If set, POST /composio/connect may include callback_url only when it starts with one of these prefixes
# COMPOSIO_OAUTH_CALLBACK_URL_PREFIXES=http://localhost:3000/,https://app.example.com/
#
# If Drive pull returns HTTP 403, share the file with the same Google account you used in Composio, or
# disconnect/reconnect Google Drive in Composio so OAuth includes download tools.
#
# If POST /composio/connect returns HTTP 502, Composio’s API returned an error (often transient): retry,
# confirm the API key, and check allowed callback URLs in the Composio project. HTTP 409 means the toolkit
# is already connected for this user_id — use Pull into context instead of Connect.

